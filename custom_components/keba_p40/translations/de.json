        "config_entry_id": {
          "name": "Wallbox",
          "description": "Die KEBA P40, an der das Laden starten soll."
        },
        "token_id": {
          "name": "Karten-ID",
          "description": "RFID-Karten-ID, wie die Wallbox sie meldet."
        }
      }
    }
  },
