        "config_entry_id": {
          "name": "Wallbox",
          "description": "Die KEBA P40, an der das Laden starten soll."
        }
      }
    },
    "start_charging_with_token": {
      "name": "Laden mit Karten-ID starten",
      "description": "Startet das Laden mit einer bestimmten RFID-Karten-ID. Die ID steht dann in Automationen und Traces; die Buttons angelegter Ladekarten vermeiden das.",
